<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Port target: OpenGL ES 3.2 (compute shaders, texture buffers,
         KHR_debug are core; see android/include/pf_gl.h). -->
    <uses-feature
        android:glEsVersion="0x00030002"
        android:required="true" />

    <application
        android:label="@string/app_name"
        android:hasCode="true"
        android:allowBackup="false"
        android:theme="@android:style/Theme.NoTitleBar.Fullscreen">

        <!-- SDL2's SDLActivity boots the native code; getLibraries() loads
             "SDL2" and then "main". -->
        <activity
            android:name="org.libsdl.app.SDLActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:screenOrientation="fullSensor"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode|density|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
